# RipoDoc self-hosted production environment template.
# Copy to .env, set mode 600, and replace every bracketed value with an
# independent production secret or approved provider value. Do not commit .env.

# PostgreSQL
POSTGRES_PASSWORD=<generate-a-long-random-database-password>

# Server-only RipoDoc secrets: all must be distinct and at least 32 characters.
RIPODOC_AUTH_SECRET=<generate-a-distinct-random-secret>
RIPODOC_EVIDENCE_SECRET=<generate-a-distinct-random-secret>
RIPODOC_WORKER_AUTH_SECRET=<generate-a-distinct-random-secret>
# Exactly 32 decoded bytes, encoded with base64url.
RIPODOC_LEAD_ENCRYPTION_KEY=<openssl-rand-base64-32-converted-to-base64url>

# Canonical public origin. HTTPS only; no path, query, fragment, or credentials.
RIPODOC_APP_ORIGIN=https://reports.example-msp.com
RIPODOC_PORT=3000

# email service production sender configuration.
RIPODOC_RESEND_API_KEY=re_<production-api-key>
RIPODOC_EMAIL_FROM=RipoDoc <reports@example-msp.com>

# edge-infrastructure provider challenge service production widget.
RIPODOC_TURNSTILE_SECRET=<turnstile-secret>
NEXT_PUBLIC_RIPODOC_TURNSTILE_SITE_KEY=<turnstile-site-key>

# Private worker capacity. Keep the worker private; do not set a public worker URL.
RIPODOC_WORKER_MAX_CONCURRENT_JOBS=2

# Optional anonymous Web Vitals logging. Disabled unless both values are true.
RIPODOC_WEB_VITALS_LOG=false
NEXT_PUBLIC_RIPODOC_WEB_VITALS_ENABLED=false

# Optional isolated RipoDoc CRM connector. Leave every value absent to keep CRM sync disabled.
# RIPODOC_CRM_URL=https://crm.example-msp.com
# RIPODOC_CRM_ALLOWED_HOSTS=crm.example-msp.com
# RIPODOC_CRM_API_KEY=<dedicated-espo-hmac-api-key>
# RIPODOC_CRM_HMAC_SECRET=<dedicated-espo-hmac-secret>
