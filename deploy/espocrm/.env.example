# Copy to .env on the separate CRM host. Do not commit .env.
# Review Docker Hub digests on every upgrade; do not replace these values with a floating latest tag.
MARIADB_IMAGE=mariadb:11.4
# Official 10.0.4 Apache image tag; verify its multi-architecture digest before production use.
ESPOCRM_IMAGE=espocrm/espocrm:10.0.4-apache

# Bind only to loopback. A separately managed TLS reverse proxy exposes crm.example.com.
ESPOCRM_BIND_PORT=8088
ESPOCRM_SITE_URL=https://crm.example.com

# Generate independent high-entropy values. Do not reuse any RipoDoc application,
# database, evidence, authentication, email, or deployment secret.
ESPOCRM_DATABASE_NAME=espocrm
ESPOCRM_DATABASE_USER=espocrm
ESPOCRM_DATABASE_PASSWORD=replace-with-a-long-random-database-password
ESPOCRM_DATABASE_ROOT_PASSWORD=replace-with-a-separate-long-random-root-password
ESPOCRM_ADMIN_USERNAME=crm-admin
ESPOCRM_ADMIN_PASSWORD=replace-with-a-separate-long-random-admin-password

# Configure these only in the RipoDoc application environment, never in this file:
# RIPODOC_ESPOCRM_URL=https://crm.example.com
# RIPODOC_ESPOCRM_ALLOWED_HOSTS=crm.example.com
# RIPODOC_ESPOCRM_API_KEY=generated-by-a-least-privileged-EspoCRM-API-user
# RIPODOC_ESPOCRM_HMAC_SECRET=generated-by-that-EspoCRM-API-user
