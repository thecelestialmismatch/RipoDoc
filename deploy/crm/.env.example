# Copy to .env on the separate CRM host. Do not commit .env.
# Review Docker Hub digests on every upgrade; do not replace these values with a floating latest tag.
MARIADB_IMAGE=mariadb:11.4
# Official 10.0.4 Apache image tag; verify its multi-architecture digest before production use.
CRM_IMAGE=crm/crm:10.0.4-apache

# Bind only to loopback. A separately managed TLS reverse proxy exposes crm.example.com.
CRM_BIND_PORT=8088
CRM_SITE_URL=https://crm.example.com

# Generate independent high-entropy values. Do not reuse any RipoDoc application,
# database, evidence, authentication, email, or deployment secret.
CRM_DATABASE_NAME=crm
CRM_DATABASE_USER=crm
CRM_DATABASE_PASSWORD=replace-with-a-long-random-database-password
CRM_DATABASE_ROOT_PASSWORD=replace-with-a-separate-long-random-root-password
CRM_ADMIN_USERNAME=crm-admin
CRM_ADMIN_PASSWORD=replace-with-a-separate-long-random-admin-password

# Configure these only in the RipoDoc application environment, never in this file:
# RIPODOC_CRM_URL=https://crm.example.com
# RIPODOC_CRM_ALLOWED_HOSTS=crm.example.com
# RIPODOC_CRM_API_KEY=generated-by-a-least-privileged-RipoDoc CRM-API-user
# RIPODOC_CRM_HMAC_SECRET=generated-by-that-RipoDoc CRM-API-user
